From 3441da7b7c9c884a764612dfa7800bf856485590 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 20 Sep 2026 03:41:53 +0000
Subject: [PATCH] Match reveal-panel headings to question font, use Courier New
 for answers, retune yellow and history colors

"A little mystery first." and "Answers are in." now use the same
Georgia serif as the daily question, and the answer textarea
switches to Courier New. The yellow accent (--acid) moves to a
lighter #FFF8BF, and the History page's fun/reflective legend,
calendar dots, and badges now match the peach/blue used on the
question page instead of the old yellow/gray-blue.
---
 dist/styles.css | 21 ++++++++++++---------
 1 file changed, 12 insertions(+), 9 deletions(-)

diff --git a/dist/styles.css b/dist/styles.css
index 0bf451c..bf38b23 100644
--- a/dist/styles.css
+++ b/dist/styles.css
@@ -2,7 +2,7 @@
   color-scheme: light;
   --ink: #22285c;
   --paper: #fffaf2;
-  --acid: #fff394;
+  --acid: #fff8bf;
   --blue: #9dbfe8;
   --blue-soft: #dfeaf3;
   --blue-mellow: #cff2ff;
@@ -294,6 +294,7 @@ textarea {
   outline: 0;
   background: transparent;
   color: var(--ink);
+  font-family: "Courier New", Courier, monospace;
   font-size: 1.3rem;
   line-height: 1.45;
 }
@@ -385,6 +386,8 @@ textarea:focus { box-shadow: inset 0 -3px 0 var(--acid); }
 .locked-state h2,
 .revealed-state h2 {
   margin: 0 0 14px;
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 600;
   font-size: clamp(2rem, 4vw, 4rem);
   line-height: 1;
 }
@@ -537,9 +540,9 @@ textarea:focus { box-shadow: inset 0 -3px 0 var(--acid); }
 .history-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.82rem; font-weight: 750; }
 .history-legend span { display: flex; align-items: center; gap: 7px; }
 .legend-dot { width: 11px; height: 11px; border-radius: 50%; border: 1px solid var(--ink); }
-.fun-dot { background: var(--acid); }
-.reflective-dot { background: var(--blue); }
-.both-dot { background: linear-gradient(135deg, var(--acid) 50%, var(--blue) 50%); }
+.fun-dot { background: var(--pink-cotton); }
+.reflective-dot { background: var(--blue-mellow); }
+.both-dot { background: linear-gradient(135deg, var(--pink-cotton) 50%, var(--blue-mellow) 50%); }
 .history-layout { display: grid; grid-template-columns: minmax(440px, 1.1fr) minmax(320px, 0.9fr); align-items: start; border-top: 1px solid var(--ink); }
 .calendar {
   padding: 28px 34px 28px 0;
@@ -579,16 +582,16 @@ textarea:focus { box-shadow: inset 0 -3px 0 var(--acid); }
   border: 1px solid var(--ink);
   border-radius: 50%;
   transform: translateX(-50%);
-  background: var(--acid);
+  background: var(--pink-cotton);
 }
-.calendar-day.has-reflective::after { background: var(--blue); }
-.calendar-day.has-both::after { background: linear-gradient(135deg, var(--acid) 50%, var(--blue) 50%); }
+.calendar-day.has-reflective::after { background: var(--blue-mellow); }
+.calendar-day.has-both::after { background: linear-gradient(135deg, var(--pink-cotton) 50%, var(--blue-mellow) 50%); }
 .history-detail { height: 390px; padding: 34px 0 34px clamp(28px, 5vw, 68px); overflow-y: auto; }
 .history-detail h2 { margin: 20px 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 3.5vw, 3.6rem); font-weight: 600; line-height: 1.08; }
 .history-badges { display: flex; gap: 8px; flex-wrap: wrap; }
 .history-badge { padding: 6px 9px; border: 1px solid var(--ink); border-radius: 4px; font-size: 0.75rem; font-weight: 850; }
-.history-badge.fun { background: var(--acid); }
-.history-badge.reflective { background: var(--blue); }
+.history-badge.fun { background: var(--pink-cotton); }
+.history-badge.reflective { background: var(--blue-mellow); }
 .history-badge.circle { background: var(--green); }
 .history-badge.private { background: white; }
 .history-badge.public { background: var(--pink); }
-- 
2.43.0

