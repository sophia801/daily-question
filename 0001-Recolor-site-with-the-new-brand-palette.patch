From a7d5917a8536a294100cee864edff39b376e0ffe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 20 Sep 2026 03:30:22 +0000
Subject: [PATCH] Recolor site with the new brand palette

Map the 5-color palette onto existing roles: reflective background
to the light blue, fun background to the peach, ink and berry (the
site's two dark accents) to navy and red, and the yellow accent
color used for streak cards and other filled boxes to the palette's
light yellow.
---
 dist/styles.css | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/dist/styles.css b/dist/styles.css
index d05fd01..0a88cc2 100644
--- a/dist/styles.css
+++ b/dist/styles.css
@@ -1,17 +1,17 @@
 :root {
   color-scheme: light;
-  --ink: #25312d;
+  --ink: #22285c;
   --paper: #fffaf2;
-  --acid: #f2dc6d;
+  --acid: #fff394;
   --blue: #9dbfe8;
   --blue-soft: #dfeaf3;
-  --blue-mellow: #cfe3f5;
+  --blue-mellow: #b0eaff;
   --pink: #ef9c8f;
-  --pink-cotton: #ffd3ea;
+  --pink-cotton: #ffbeb0;
   --green: #99c7ad;
   --line: #c9cbc2;
   --soft: #f2eee5;
-  --berry: #994f55;
+  --berry: #c73434;
   font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
 }
 
@@ -259,7 +259,7 @@ h1 {
 .streak-board:has(.circle-streak[hidden]) { grid-template-columns: minmax(0, 1fr); }
 .streak-card { min-width: 0; padding: 15px 16px 14px; background: rgba(255, 255, 255, 0.45); }
 .streak-card + .streak-card { border-left: 1px solid var(--ink); }
-.personal-streak { background: #fff3d7; }
+.personal-streak { background: var(--acid); }
 .circle-streak { background: var(--blue-soft); }
 .streak-card-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 12px; }
 .streak-card-heading strong { font-family: Georgia, "Times New Roman", serif; font-size: 1.3rem; font-weight: 600; white-space: nowrap; }
@@ -658,7 +658,7 @@ textarea:focus { box-shadow: inset 0 -3px 0 var(--acid); }
   grid-template-columns: 1fr minmax(150px, 220px);
   gap: 24px;
   align-items: center;
-  background: #fff3d7;
+  background: var(--acid);
 }
 .circle-streak-panel .eyebrow { margin: 0 0 4px; color: var(--berry); }
 .streak-safe { margin-left: 6px; padding: 3px 6px; border-radius: 3px; background: var(--green); color: var(--ink); font-size: 0.64rem; }
@@ -769,7 +769,7 @@ textarea:focus { box-shadow: inset 0 -3px 0 var(--acid); }
 .ritual-limit strong { color: var(--berry); }
 .ritual-options { display: grid; gap: 9px; margin-bottom: 20px; }
 .ritual-option { padding: 15px; border: 1px solid var(--line); border-radius: 7px; background: rgba(255, 255, 255, 0.45); }
-.ritual-option.enabled { border-color: var(--ink); background: #fff3d7; }
+.ritual-option.enabled { border-color: var(--ink); background: var(--acid); }
 .ritual-option-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
 .ritual-copy strong,
 .ritual-copy small { display: block; }
-- 
